# Copy this file to .env and fill in your values.
# Never commit the real .env file to git.
DATABASE_URL: postgresql://user:password@localhost:5432/mentree_db
ACCESS_SECRET_KEY: your-access token-secret-key-here
REFRESH_SECRET_KEY: your-refresh token-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES: 60
REFRESH_TOKEN_EXPIRE_DAYS:7